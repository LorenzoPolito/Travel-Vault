---
interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 24, class: className = '', label } = Astro.props;
const svg = `w-${size} h-${size}`;
const role = label ? `img` : `presentation`;
const ariaLabel = label ?? name;
---

<svg
  class={`icon icon-${name} ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={role}
  aria-label={ariaLabel}
>
  {name === 'bag' && <><path d="M6 6h12l2 14H4L6 6z"/><path d="M9 6V5a3 3 0 016 0v1"/></>}
  {name === 'map' && <><path d="M3 7v14l5-2 4 2 4-2 5 2V5l-5 2-4-2-4 2L3 7z"/><path d="M12 5v14"/></>}
  {name === 'book' && <><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></>}
  {name === 'globe' && <><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 010 20 15.3 15.3 0 010-20z"/></>}
  {name === 'pin' && <><circle cx="12" cy="11" r="3"/><path d="M19 11a7 7 0 01-7 7 7 7 0 01-7-7 7 7 0 0114 0z"/></>}
  {name === 'compass' && <><circle cx="12" cy="12" r="10"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2"/><path d="M7 17l3-8 8-3-3 8z"/></>}
  {name === 'star' && <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>}
  {name === 'star-o' && <><path d="M12 2l1.7 5.3L19 7.7l-4 3.9 1.2 5.4L12 14l-4.2 3 1.2-5.4-4-3.9 5.3-.4L12 2z"/></>}
  {name === 'arrow-r' && <><path d="M5 12h14"/><path d="M13 5l7 7-7 7"/></>}
  {name === 'chevron-r' && <polyline points="9 18 15 12 9 6"/>}
  {name === 'menu' && <><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></>}
  {name === 'users' && <><circle cx="9" cy="7" r="4"/><path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/><path d="M16 3.13a4 4 0 010 7.75"/></>}
  {name === 'coin' && <><circle cx="12" cy="12" r="10"/><path d="M12 6v12m-3-3l3 3 3-3"/></>}
  {name === 'train' && <><rect x="4" y="3" width="16" height="13" rx="2"/><path d="M9 16l-2 5m8-5l2 5"/><circle cx="9" cy="10" r="1"/><circle cx="15" cy="10" r="1"/></>}
  {name === 'plane' && <><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8l-8.2-1.8L3 8l6 4-2 4 2 2 4-2 4 6 2.8-2.8z"/></>}
  {name === 'shield' && <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></>}
  {name === 'phone' && <><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></>}
  {name === 'ticket' && <><path d="M2 9a3 3 0 010 6v2a2 2 0 002 2h16a2 2 0 002-2v-2a3 3 0 010-6V7a2 2 0 00-2-2H4a2 2 0 00-2 2v2z"/><path d="M13 5v2m0 10v2"/></>}
  {name === 'city' && <><path d="M4 21V9l4-3 4 3v12"/><path d="M8 21V7m12-3l-4 2v15"/><path d="M12 21V5a2 2 0 012-2h2a2 2 0 012 2v16"/><path d="M16 11h2m-2 3h2m-2 3h2"/><path d="M6 13h2m-2 3h2"/></>}
  {name === 'temple' && <><path d="M12 2l7 5v4H5V7z"/><path d="M5 16h14"/><path d="M3 21h18"/><path d="M8 11v5m8-5v5m-4-5v5"/></>}
  {name === 'park' && <><path d="M12 2l3 5h4l-3 4 2 6H6l2-6L5 7h4z"/><path d="M8 21h8"/></>}
  {name === 'build' && <><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="9" y1="6" x2="9" y2="6.01"/><line x1="15" y1="6" x2="15" y2="6.01"/><line x1="9" y1="10" x2="9" y2="10.01"/><line x1="15" y1="10" x2="15" y2="10.01"/></>}
  {name === 'store' && <><path d="M3 9l2-7h14l2 7"/><path d="M9 9v3a3 3 0 006 0V9"/><rect x="3" y="9" width="18" height="12" rx="2"/></>}
  {name === 'castle' && <><path d="M3 21V7l3-2 3 2v14"/><path d="M15 21V5l3-2 3 2v16"/><path d="M9 11h6"/><path d="M9 15h6"/><path d="M9 19h6"/></>}
  {name === 'hotel' && <><path d="M3 21V7l3-2 18 16"/><rect x="9" y="7" width="6" height="4"/><path d="M9 21v-6a2 2 0 012-2h2a2 2 0 012 2v6"/></>}
  {name === 'food' && <><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M3 8v8h15V8"/><path d="M3 8V5a2 2 0 012-2h1a2 2 0 012 2v3"/><path d="M16 8V5a2 2 0 00-2-2h-1"/><path d="M18 16v5"/></>}
  {name === 'quarter' && <><path d="M2 21V9l4-3 4 3v12"/><path d="M6 21V7m4 4h6l-2 4 2 4h-6"/></>}
  {name === 'street' && <><line x1="3" y1="21" x2="21" y2="3"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/></>}
  {name === 'active' && <circle cx="12" cy="12" r="4" fill="currentColor"/>}
  {name === 'info' && <><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></>}
  {name === 'alert' && <><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></>}
  {name === 'search' && <><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></>}
  {name === 'link' && <><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></>}
  {name === 'heart' && <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>}
  {name === 'sun' && <><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></>}
  {name === 'moon' && <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>}
  {name === 'close' && <><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></>}
  {name === 'check' && <polyline points="20 6 9 17 4 12"/>}
  {name === 'external' && <><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></>}
  {name === 'flag-jp' && <><rect x="4" y="4" width="16" height="16" rx="2" fill="white"/><circle cx="12" cy="12" r="5" fill="#BC002D"/></>}
  {name === 'flag-it' && <><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="4" y="4" width="5.33" height="16" fill="#009246"/><rect x="14.67" y="4" width="5.33" height="16" fill="#CE2B37"/></>}
  {name === 'flag-globe' && <><circle cx="12" cy="12" r="9"/><path d="M3.6 9h16.8M3.6 15h16.8"/><ellipse cx="12" cy="12" rx="3" ry="9"/></>}
</svg>

<style>
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: middle;
    flex-shrink: 0;
  }
</style>
