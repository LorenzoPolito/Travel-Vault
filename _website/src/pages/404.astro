---
import Base from '../layouts/Base.astro';
import { R, url } from '../constants';
const base = import.meta.env.BASE_URL;
const $ = (p: string) => url(base, p);
---

<Base title="Pagina non trovata">
  <section class="section" style="min-height: 60vh; display: flex; align-items: center;">
    <div class="container" style="text-align: center;">
      <div style="font-size: 6rem; margin-bottom: var(--space-lg); opacity: 0.3;">🧭</div>
      <h1 style="font-size: clamp(3rem, 6vw, 5rem); margin-bottom: var(--space-sm);">404</h1>
      <p style="font-size: 1.2rem; color: var(--text-muted); max-width: 500px; margin: 0 auto var(--space-2xl);">
        Questa pagina non esiste nel vault. Forse è stata spostata o mai creata.
      </p>
      <div class="flex gap-md" style="justify-content: center; flex-wrap: wrap;">
        <a href={$(R.home)} class="hero-btn hero-btn--primary">Torna alla Home</a>
        <a href={$(R.destinations)} class="hero-btn hero-btn--secondary">Esplora Destinazioni</a>
        <a href={$(R.itineraries)} class="hero-btn hero-btn--secondary">Vedi Itinerari</a>
      </div>
    </div>
  </section>
</Base>
