---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { R, url, slugToName, starsFromRating, getCategoryEmoji, getDestinationEmoji, destSlug } from '../../../constants';
import { getLocationsByDest, getItinerariesByDest } from '../../../data';

export async function getStaticPaths() {
  const { getDestinations } = await import('../../../data');
  const dests = await getDestinations();
  return dests.map(dest => ({
    params: { dest: destSlug(dest) },
    props: { destination: dest },
  }));
}

const { destination } = Astro.props;
const base = import.meta.env.BASE_URL;
const $ = (p: string) => url(base, p);

const [locations, itineraries] = await Promise.all([
  getLocationsByDest(destination),
  getItinerariesByDest(destination),
]);

const cities = locations.filter((l: any) => l.data.type === 'city');
const pois = locations.filter((l: any) => l.data.type === 'location' || !l.data.type);

const categories: Record<string, any[]> = {};
pois.forEach((poi: any) => {
  const cat = poi.data.category || 'Altro';
  if (!categories[cat]) categories[cat] = [];
  categories[cat].push(poi);
});

const destEmoji = getDestinationEmoji(destination);
---

<Base title={destination} description={`Tutti i luoghi, itinerari e guide per ${destination}`}>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[
        { label: 'Home', href: R.home },
        { label: 'Destinazioni', href: R.destinations },
        { label: destination },
      ]} />

      <div class="page-header page-header--flush">
        <h1 class="page-title">{destEmoji} {destination}</h1>
        <div class="page-meta">
          <span class="tag">{cities.length} città</span>
          <span class="tag tag--info">{pois.length} luoghi</span>
          <span class="tag tag--success">{itineraries.length} itinerari</span>
        </div>
      </div>

      {cities.length > 0 && (
        <div class="mb-3xl">
          <div class="section-header">
            <p class="section-label">Città</p>
            <h2>Le città da esplorare</h2>
          </div>
          <div class="cards-grid">
            {cities.map((city: any) => {
              const cityName = slugToName(city.id);
              const cityPois = pois.filter((p: any) => p.data.city && cityName.toLowerCase().includes(p.data.city.toLowerCase()));
              return (
                <a href={$(R.location(city.id))} class="card animate-in a--plain">
                  <div class="card-emoji">🏙️</div>
                  <h3 class="card-title">{cityName}</h3>
                  <p class="card-description">{cityPois.length} punti di interesse</p>
                </a>
              );
            })}
          </div>
        </div>
      )}

      {Object.keys(categories).length > 0 && (
        <div class="mb-3xl">
          <div class="section-header">
            <p class="section-label">Luoghi</p>
            <h2>Punti di interesse per categoria</h2>
          </div>
          {Object.entries(categories).map(([cat, items]) => (
            <div class="mb-xl">
              <h3>{getCategoryEmoji(cat)} {cat} ({items.length})</h3>
              <div class="cards-grid mt-lg">
                {items.slice(0, 8).map((poi: any) => {
                  const name = slugToName(poi.id);
                  const stars = poi.data.rating ? starsFromRating(poi.data.rating) : '';
                  return (
                    <a href={$(R.location(poi.id))} class="card animate-in a--plain">
                      <h4 class="card-title">{name}</h4>
                      <div class="card-meta">
                        {stars && <span class="rs">{stars}</span>}
                        {poi.data.city && <span class="tag">{poi.data.city}</span>}
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      )}

      {itineraries.length > 0 && (
        <div>
          <div class="section-header">
            <p class="section-label">Itinerari</p>
            <h2>Viaggi pianificati</h2>
          </div>
          <div class="cards-grid">
            {itineraries.map((itin: any) => {
              const name = slugToName(itin.id);
              return (
                <a href={$(R.itinerary(itin.id))} class="card animate-in a--plain">
                  <div class="card-emoji">🗺️</div>
                  <h3 class="card-title">{name}</h3>
                  <div class="card-meta">
                    {itin.data.durata && <span class="tag tag--info">{itin.data.durata}</span>}
                    {itin.data.status && <span class="tag tag--success">{itin.data.status}</span>}
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </section>
</Base>
