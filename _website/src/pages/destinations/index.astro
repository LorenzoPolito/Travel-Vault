---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { R, url, slugToName } from '../../constants';
import { getDestinations, getLocations, getItineraries, getInfo } from '../../data';

const [locations, itineraries, infoEntries, destinations] = await Promise.all([
  getLocations(),
  getItineraries(),
  getInfo(),
  getDestinations(),
]);

const base = import.meta.env.BASE_URL;
const $ = (p: string) => url(base, p);

const destEmoji = (d: string) =>
  d.toLowerCase() === 'japan' ? '🇯🇵' : d.toLowerCase() === 'italia' ? '🇮🇹' : '🌍';
---

<Base title="Destinazioni" description="Tutte le destinazioni disponibili nel vault">
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: R.home }, { label: 'Destinazioni' }]} />

      <div class="page-header page-header--flush">
        <h1 class="page-title">🌍 Destinazioni</h1>
        <p>Esplora {destinations.length} destinazioni con {locations.length} luoghi e {itineraries.length} itinerari</p>
      </div>

      {destinations.length > 0 ? (
        <div class="cards-grid">
          {destinations.map((dest) => {
            const destLocations = locations.filter((l: any) => l.data.destination === dest);
            const destItineraries = itineraries.filter((i: any) => i.data.destination === dest);
            const destCities = destLocations.filter((l: any) => l.data.type === 'city');
            return (
              <a href={$(R.destination(dest.toLowerCase()))} class="card animate-in a--plain">
                <div class="card-emoji" style="font-size: 3rem">{destEmoji(dest)}</div>
                <h3 class="card-title" style="font-size: 1.5rem">{dest}</h3>
                <p class="card-description">
                  {destCities.length} città • {destLocations.length} luoghi • {destItineraries.length} itinerari
                </p>
                {destCities.length > 0 && (
                  <div class="card-meta mt-lg">
                    {destCities.map((c: any) => (
                      <span class="tag">{slugToName(c.id)}</span>
                    ))}
                  </div>
                )}
              </a>
            );
          })}
        </div>
      ) : (
        <p style="color: var(--text-muted); padding: var(--space-2xl) 0; text-align: center;">Nessuna destinazione trovata.</p>
      )}
    </div>
  </section>
</Base>
