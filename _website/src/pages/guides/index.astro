---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EmptyState from '../../components/EmptyState.astro';
import { R, url, slugToName, getGuideCategoryEmoji } from '../../constants';
import { getInfo } from '../../data';

const infoEntries = await getInfo();
const base = import.meta.env.BASE_URL;
const $ = (p: string) => url(base, p);
---

<Base title="Guide" description="Guide pratiche per i tuoi viaggi">
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[
        { label: 'Home', href: R.home },
        { label: 'Guide' },
      ]} />

      <div class="page-header page-header--flush">
        <h1 class="page-title">📖 Guide Pratiche</h1>
        <p>{infoEntries.length} guide disponibili</p>
      </div>

      {infoEntries.length > 0 ? (
        <div class="cards-grid">
          {infoEntries.map((info: any) => {
            const name = slugToName(info.id.split('/').pop() || info.id);
            const cat = info.data.category || info.data.categoria || '';
            return (
              <a href={$(R.guide(info.id))} class="card animate-in a--plain">
                <div class="card-emoji">{getGuideCategoryEmoji(cat)}</div>
                <h3 class="card-title">{name}</h3>
                <div class="card-meta">
                  {info.data.destination && <span class="tag">{info.data.destination}</span>}
                  {cat && <span class="tag tag--info">{cat}</span>}
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <EmptyState icon="📖" title="Nessuna guida disponibile" description="Le guide non sono state ancora sincronizzate dal vault." />
      )}
    </div>
  </section>
</Base>
