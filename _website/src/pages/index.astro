---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HomeItineraries from '../sections/HomeItineraries.astro';
import HomeDestinations from '../sections/HomeDestinations.astro';
import HomeGuides from '../sections/HomeGuides.astro';
import { R, url } from '../constants';
import { getDestinations, getLocations, getItineraries, getInfo, getCities, getActiveItinerary, getOtherItineraries } from '../data';

const [locations, itineraries, infoEntries, cities, activeItin, otherItins, destinations] = await Promise.all([
  getLocations(),
  getItineraries(),
  getInfo(),
  getCities(),
  getActiveItinerary(),
  getOtherItineraries(),
  getDestinations(),
]);

const base = import.meta.env.BASE_URL;
const $ = (p: string) => url(base, p);
---

<Base title="Home">
  <section class="hero">
    <div class="container">
      {activeItin && (
        <div class="hero-badge animate-in">
          <span class="badge-dot"></span>
          Viaggio attivo: Giappone 2026 — 23 Ott · 6 Nov
        </div>
      )}
      <h1>Esplora il mondo con<br/><span class="text-gradient">Travel-Vault</span></h1>
      <p class="hero-subtitle">
        {destinations.length} destinazioni, {cities.length} città, {locations.length} luoghi da scoprire —
        itinerari dettagliati, mappe interattive e guide pratiche in un unico spazio.
      </p>

      <div class="hero-actions animate-in">
        {activeItin && (
          <a href={$(R.itinerary(activeItin.id))} class="hero-btn hero-btn--primary">
            Vedi Itinerario Attivo <Icon name="arrow-r" size={16} style="margin-left: 4px;" />
          </a>
        )}
        <a href={$(R.destinations)} class="hero-btn hero-btn--secondary">
          Esplora Destinazioni
        </a>
      </div>

      <div class="hero-stats">
        {[
          { label: 'Destinazioni', value: destinations.length },
          { label: 'Luoghi', value: locations.length },
          { label: 'Itinerari', value: itineraries.length },
          { label: 'Città', value: cities.length },
        ].map(s => (
          <div class="stat animate-in">
            <span class="stat-number">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <HomeItineraries active={activeItin} others={otherItins} base={base} />
  <HomeDestinations destinations={destinations} locations={locations} itineraries={itineraries} base={base} />
  <HomeGuides entries={infoEntries} base={base} />
</Base>
