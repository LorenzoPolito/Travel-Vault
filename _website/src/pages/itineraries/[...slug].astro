---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { R, url, PRETTY_NAMES, extractCoverImage, slugToName } from '../../constants';

export async function getStaticPaths() {
  const { getItineraries } = await import('../../data');
  const entries = await getItineraries();
  return entries.map((entry: any) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL;
const $ = (p: string) => url(base, p);

const displayName = PRETTY_NAMES[entry.id.replace(/\.md$/, '')] || slugToName(entry.id);
const coverImage = extractCoverImage(entry.body);
const isJapanCompanion = entry.id.includes('23ott-6nov2026');
const companionUrl = $('/downloads/Giappone-2026-Companion.xlsx');

const dayHeadings: Array<{ text: string; anchor: string }> = [];
// Match FULL heading lines containing "Giorno" or "Day"
const headingRegex = /^(#{1,3})\s+(.*(?:\bGiorno\b|\bDay\b).*)$/gim;
let match;
while ((match = headingRegex.exec(entry.body)) !== null) {
  const raw = match[0]; // e.g., "## Giorno 1 — Sabato 24 Ottobre — Partenza"
  const text = raw.replace(/^#+\s+/, '');
  // Generate the SAME anchor ID that Astro's markdown processor produces
  const anchor = text
    .toLowerCase()
    .replace(/[^\w\s-]/g, '-')  // replace non-word, non-space, non-hyphen chars with hyphen
    .replace(/\s+/g, '-')       // collapse whitespace to hyphen
    .replace(/-+/g, '-')        // collapse multiple hyphens
    .replace(/^-|-$/g, '');     // trim leading/trailing hyphens
  dayHeadings.push({ text, anchor });
}

---

<Base title={displayName} description={`Itinerario: ${displayName}`}>
  {coverImage && (
    <div class="itinerary-cover" style={`background-image: url('${coverImage}');`}>
      <div class="itinerary-cover-overlay"></div>
    </div>
  )}

  <section class="section" style={coverImage ? "padding-top: 0;" : ""}>
    <div class="container">
      <Breadcrumbs items={[
        { label: 'Home', href: R.home },
        { label: 'Itinerari', href: R.itineraries },
        { label: displayName },
      ]} />

      <div class="page-header">
        <h1 class="page-title">{displayName}</h1>
        <div class="page-meta">
          {entry.data.destination && <span class="tag">{entry.data.destination}</span>}
          {entry.data.durata && <span class="tag tag--info">{entry.data.durata}</span>}
          {entry.data.durata_giorni && <span class="tag tag--info">{entry.data.durata_giorni} giorni</span>}
          {entry.data.status && <span class="tag tag--success">{entry.data.status}</span>}
          {entry.data.budget_totale_stimato && (
            <span class="tag"><Icon name="coin" size={14} class="icon-tag" /> {entry.data.budget_totale_stimato}</span>
          )}
          {entry.data.autori?.length > 0 && (
            <span class="tag"><Icon name="users" size={14} class="icon-tag" /> {entry.data.autori.join(', ')}</span>
          )}
        </div>
      </div>

      <div class="split-layout">
        <div class="content-left">
          <article class="prose">
            <Content />
          </article>
        </div>
        <div class="content-right">
          <aside class="sticky-sidebar sidebar-content">
            {dayHeadings.length > 0 && (
              <div class="sidebar-card">
                <h3 class="sidebar-title">📅 Giorni</h3>
                <nav class="day-nav" id="dayNav">
                  {dayHeadings.map(d => (
                    <a href={`#${d.anchor}`} class="day-link" data-day-text={d.text}>
                      <span class="day-dot"></span>
                      {d.text}
                    </a>
                  ))}
                </nav>
              </div>
            )}

            {entry.data.percorso && (
              <div class="sidebar-card">
                <h3 class="sidebar-title">🛤️ Percorso</h3>
                <div class="route-pills">
                  {entry.data.percorso.split('→').map((step: string) => (
                    <span class="route-pill">{step.trim()}</span>
                  ))}
                </div>
              </div>
            )}

            {isJapanCompanion && (
              <div class="sidebar-card">
                <h3 class="sidebar-title">📊 Companion Excel</h3>
                <p class="sidebar-download-text">
                  Tracker di attività, spese (stile Tricount), prenotazioni e scadenze.
                  Si aggiorna da solo con le formule.
                </p>
                <a href={companionUrl} download class="sidebar-download-btn">
                  <Icon name="external" size={16} /> Scarica il file
                </a>
              </div>
            )}
          </aside>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .itinerary-cover {
    width: 100%;
    height: 40vh;
    background-size: cover;
    background-position: center;
    position: relative;
    margin-bottom: var(--space-xl);
    border-radius: 0 0 var(--radius-xl) var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }
  .itinerary-cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--bg-primary) 0%, transparent 100%);
  }
  .sidebar-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .sidebar-download-text {
    margin: 0 0 var(--space-sm);
    font-size: 0.85rem;
    color: var(--text-secondary, #6b7280);
    line-height: 1.4;
  }
  .sidebar-download-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 14px;
    border-radius: var(--radius-md, 10px);
    background: var(--accent, #d94f79);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .sidebar-download-btn:hover {
    opacity: 0.88;
  }
</style>

<script>
  // Day navigation: scroll to heading by text content (robust vs mismatched IDs)
  document.addEventListener('astro:page-load', () => {
    const nav = document.getElementById('dayNav');
    if (!nav) return;
    nav.querySelectorAll('[data-day-text]').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const text = link.getAttribute('data-day-text');
        if (!text) return;
        // Find the heading by text content
        const headings = document.querySelectorAll('h1, h2, h3, h4, h5, h6');
        for (const h of headings) {
          if (h.textContent?.trim() === text.trim()) {
            const top = h.getBoundingClientRect().top + window.scrollY - 100;
            window.scrollTo({ top, behavior: 'smooth' });
            break;
          }
        }
      });
    });
  });
</script>
