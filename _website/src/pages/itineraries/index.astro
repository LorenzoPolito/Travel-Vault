---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { R, url, slugToName } from '../../constants';

const itineraries = await getCollection('itineraries');
const base = import.meta.env.BASE_URL;
const $ = (p: string) => url(base, p);
const activeItin = itineraries.find(i => i.id.startsWith('itinerario-giappone-24ott'));
const otherItins = itineraries.filter(i => i !== activeItin);
---

<Base title="Itinerari" description="Tutti gli itinerari di viaggio disponibili">
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[
        { label: 'Home', href: R.home },
        { label: 'Itinerari' },
      ]} />

      <div class="page-header page-header--flush">
        <h1 class="page-title">🗺️ Itinerari</h1>
        <p>{itineraries.length} itinerari pianificati{activeItin ? ' — 1 attivo' : ''}</p>
      </div>

      {activeItin && (
        <a href={$(R.itinerary(activeItin.id))} class="card card--featured animate-in a--plain mb-2xl">
          <div class="featured-glow"></div>
          <div class="featured-badge">🟢 Viaggio Attivo — Giappone 2026</div>
          <div class="featured-content">
            <h3 class="card-title" style="font-size: 1.5rem;">Giappone 2026 — 24 Ott · 7 Nov</h3>
            <p class="featured-desc">Osaka → Hiroshima → Nara → Kyoto → Tokyo · 15 giorni, 14 notti</p>
            <div class="card-meta">
              <span class="tag tag--success">attivo</span>
              <span class="tag">Giappone</span>
              <span class="tag tag--info">15 giorni</span>
              <span class="tag">👥 Lorenzo, Davide, Rebecca</span>
              <span class="tag">💰 ~2.500 €/pax</span>
            </div>
          </div>
        </a>
      )}

      {otherItins.length > 0 && (
        <>
          <div class="section-header mt-2xl">
            <h2 style="font-size: 1.3rem;">Tutti gli Itinerari ({otherItins.length})</h2>
          </div>

          <div class="cards-grid">
            {otherItins.map((itin) => {
              const name = slugToName(itin.id);
              return (
                <a href={$(R.itinerary(itin.id))} class="card animate-in a--plain">
                  <div class="card-emoji">🗺️</div>
                  <h3 class="card-title">{name}</h3>
                  <div class="card-meta">
                    {itin.data.destination && <span class="tag">{itin.data.destination}</span>}
                    {itin.data.durata && <span class="tag tag--info">{itin.data.durata}</span>}
                    {itin.data.durata_giorni && <span class="tag tag--info">{itin.data.durata_giorni} giorni</span>}
                    {itin.data.status && <span class="tag tag--success">{itin.data.status}</span>}
                  </div>
                </a>
              );
            })}
          </div>
        </>
      )}
    </div>
  </section>
</Base>
