---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { R, url, PRETTY_NAMES, slugToName } from '../../constants';
import { getActiveItinerary, getOtherItineraries } from '../../data';

const [activeItin, otherItins] = await Promise.all([
  getActiveItinerary(),
  getOtherItineraries(),
]);

const base = import.meta.env.BASE_URL;
const $ = (p: string) => url(base, p);
---

<Base title="Itinerari" description="Tutti gli itinerari di viaggio disponibili">
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[
        { label: 'Home', href: R.home },
        { label: 'Itinerari' },
      ]} />

      <div class="page-header page-header--flush">
        <h1 class="page-title">🗺️ Itinerari</h1>
        <p>{activeItin ? otherItins.length + 1 : otherItins.length} itinerari{activeItin ? ' — 1 attivo' : ''}</p>
      </div>

      {activeItin && (() => {
        const name = PRETTY_NAMES[activeItin.id.replace(/\.md$/, '')] || slugToName(activeItin.id);
        const percorso = activeItin.data.percorso || '';
        const cities = percorso ? percorso.split('→').filter((s: string) => !/roma|kix/i.test(s)).map((s: string) => s.trim()) : [];
        const durata = activeItin.data.durata_giorni
          ? `${activeItin.data.durata_giorni} giorni${activeItin.data.durata_notti ? `, ${activeItin.data.durata_notti} notti` : ''}`
          : activeItin.data.durata || '';
        const autori = activeItin.data.autori?.join(', ') || '';
        const budget = activeItin.data.budget_totale_stimato || '';
        return (
          <a href={$(R.itinerary(activeItin.id))} class="card card--featured animate-in a--plain mb-2xl">
            <div class="featured-glow"></div>
            <div class="featured-badge"><Icon name="active" size={10} class="icon-tag" /> Viaggio Attivo — {activeItin.data.destination || name}</div>
            <div class="featured-content">
              <h3 class="card-title" style="font-size: 1.5rem;">{name}</h3>
              <p class="featured-desc">{cities.length > 0 ? cities.join(' → ') : ''} {durata ? `· ${durata}` : ''}</p>
              <div class="card-meta">
                <span class="tag tag--success">attivo</span>
                {activeItin.data.destination && <span class="tag">{activeItin.data.destination}</span>}
                {activeItin.data.durata_giorni && <span class="tag tag--info">{activeItin.data.durata_giorni} giorni</span>}
                {autori && <span class="tag"><Icon name="users" size={14} class="icon-tag" /> {autori}</span>}
                {budget && <span class="tag"><Icon name="coin" size={14} class="icon-tag" /> {budget}</span>}
              </div>
            </div>
          </a>
        );
      })()}

      {otherItins.length > 0 && (
        <>
          <div class="section-header mt-2xl">
            <h2 style="font-size: 1.3rem;">Tutti gli Itinerari ({otherItins.length})</h2>
          </div>

          <div class="cards-grid">
            {otherItins.map((itin: any) => {
              const name = slugToName(itin.id);
              return (
                <a href={$(R.itinerary(itin.id))} class="card animate-in a--plain">
                  <div class="card-emoji">🗺️</div>
                  <h3 class="card-title">{name}</h3>
                  <div class="card-meta">
                    {itin.data.destination && <span class="tag">{itin.data.destination}</span>}
                    {itin.data.durata && <span class="tag tag--info">{itin.data.durata}</span>}
                    {itin.data.durata_giorni && <span class="tag tag--info">{itin.data.durata_giorni} giorni</span>}
                    {itin.data.status && <span class="tag tag--success">{itin.data.status}</span>}
                  </div>
                </a>
              );
            })}
          </div>
        </>
      )}
    </div>
  </section>
</Base>
