---
import EmptyState from '../components/EmptyState.astro';
import { R, url, getDestinationEmoji } from '../constants';

interface Props {
  destinations: string[];
  locations: any[];
  itineraries: any[];
  base: string;
}

const { destinations, locations, itineraries, base } = Astro.props;
const $ = (p: string) => url(base, p);

const destEmoji = (d: string) => getDestinationEmoji(d);
---

<section class="section">
  <div class="container">
    <div class="section-header">
      <p class="section-label">Destinazioni</p>
      <h2>Dove vuoi andare?</h2>
    </div>

    {destinations.length > 0 ? (
      <div class="cards-grid">
        {destinations.map((dest) => {
          const destLocations = locations.filter((l: any) => l.data.destination === dest);
          const destItineraries = itineraries.filter((i: any) => i.data.destination === dest);
          const destCities = destLocations.filter((l: any) => l.data.type === 'city');
          return (
            <a href={$(R.destination(dest.toLowerCase()))} class="card animate-in a--plain">
              <div class="card-emoji">{destEmoji(dest)}</div>
              <h3 class="card-title">{dest}</h3>
              <p class="card-description">
                {destCities.length} città • {destLocations.length} luoghi • {destItineraries.length} itinerari
              </p>
            </a>
          );
        })}
      </div>
    ) : (
      <EmptyState icon="🌍" title="Nessuna destinazione" description="Aggiungi destinazioni al vault per vederle qui." />
    )}
  </div>
</section>
