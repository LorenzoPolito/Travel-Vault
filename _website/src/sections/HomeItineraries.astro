---
import Icon from '../components/Icon.astro';
import EmptyState from '../components/EmptyState.astro';
import CountryImage from '../illustrations/CountryImage.astro';
import { R, url, extractCoverImage, slugToName, getDestTheme } from '../constants';

interface Itinerary {
  id: string;
  data: Record<string, any>;
  body?: string;
}

interface Props {
  active: Itinerary | null;
  others: Itinerary[];
  base: string;
}

const { active, others, base } = Astro.props;
const $ = (p: string) => url(base, p);


---

<section class="section">
  <div class="container">
    <div class="section-header">
      <p class="section-label">Esplora in profondità</p>
      <h2>Itinerari in Evidenza</h2>
    </div>

    {active && (() => {
      const durata = active.data.durata_giorni ? `${active.data.durata_giorni} giorni` : active.data.durata || '';
      return (
        <a href={$(R.itinerary(active.id))} class="card card--featured animate-in a--plain mb-2xl">
          <div class="featured-glow"></div>
          <div class="featured-badge"><Icon name="active" size={10} class="icon-tag" /> Viaggio Attivo</div>
          <div class="featured-content">
            <h3 class="card-title" style="font-size: 1.6rem;">Giappone 2026 — 23 Ott · 6 Nov</h3>
            <p class="featured-desc">Osaka → Hiroshima → Nara → Kyoto → Tokyo · 15 giorni, 14 notti</p>
            <div class="card-meta">
              <span class="tag tag--success">attivo</span>
              <span class="tag">Giappone</span>
              <span class="tag tag--info">{durata}</span>
              <span class="tag"><Icon name="users" size={14} class="icon-tag" /> Lorenzo, Davide, Rebecca</span>
            </div>
          </div>
        </a>
      );
    })()}

    {others.length > 0 ? (
      <div class="bento-grid">
        {others.slice(0, 4).map((itin) => {
          const durata = itin.data.durata_giorni ? `${itin.data.durata_giorni} giorni` : itin.data.durata || '';
          const cover = extractCoverImage(itin.body || '');
          const name = slugToName(itin.id).replace(/Itinerario /i, '');
          const cities = itin.data.percorso || '';
          const dest = (itin.data.destination || '');
          const theme = getDestTheme(dest);
          const cityList = cities ? cities.split('→').map((s: string) => s.trim()) : [];
          return (
            <a href={$(R.itinerary(itin.id))} class="card animate-in a--plain">
              <div class="bento-img-wrapper">
                {cover ? (
                  <img src={cover} alt={name} loading="lazy" />
                ) : (
                  <div class="bento-gradient" style={`background: ${theme.gradient};`}>
                    <CountryImage dest={itin.data.destination} base={base} />
                    <div class="bento-gradient-content">
                      {cityList.length > 0 && <span class="bento-gradient-cities">{cityList.slice(0, 4).join(' → ')}</span>}
                      {durata && <span class="bento-gradient-durata">{durata}</span>}
                    </div>
                  </div>
                )}
              </div>
              <div class="bento-content">
                <h3 class="card-title">{name}</h3>
                <div class="card-meta">
                  {itin.data.destination && <span class="tag">{itin.data.destination}</span>}
                  {durata && <span class="tag tag--info">{durata}</span>}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <EmptyState icon="🗺️" title="Nessun itinerario" description="Gli itinerari non sono ancora stati sincronizzati dal vault." />
    )}
  </div>
</section>
