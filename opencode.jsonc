{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "travel-vault": {
      "description": "Agente specializzato per il Travel-Vault Obsidian workspace: pianificazione viaggi Giappone 2026, gestione vault e pubblicazione sito",
      "model": "anthropic/claude-sonnet-4-5"
    }
  },
  "default_agent": "build",
  "permission": {
    "bash": "allow",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow"
  },
  "instructions": ["AGENTS.md", ".agents/skills/travel-vault-agent/SKILL.md"],
  "watcher": {
    "ignore": [".obsidian/**", "_website/node_modules/**", "_website/dist/**", "_website/public/images/vault/**", "allegati/**", ".git/**"]
  }
}
